{
  "name": "monoprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "test": "node --import tsx --test src/shared/schema.test.ts server/*.test.ts server/recovery/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "sidecar": "sh scripts/start-local.sh --sidecar-only",
    "recover": "tsx scripts/recovery-smoke.ts",
    "local": "sh scripts/start-local.sh"
  },
  "dependencies": {
    "@openai/agents": "latest",
    "@xmldom/xmldom": "0.8.15",
    "cldr-misc-full": "48.2.0",
    "dotenv": "latest",
    "express": "latest",
    "fontkit": "latest",
    "harfbuzzjs": "1.6.1",
    "html-to-image": "^1.11.13",
    "jszip": "3.10.1",
    "mammoth": "^1.12.2",
    "mdast-util-from-markdown": "^2.0.3",
    "openai": "latest",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.58.2",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.4",
    "undici": "^8.10.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/fontkit": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
