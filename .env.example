OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=1200000
PORT=4175
# Optional font catalog override. By default the app uses the fonts installed on this Mac.
# FONT_LIBRARY_PATH=/path/to/a/custom/font/directory

# Pinned text recovery pipeline in .local/pipeline. Start both services: npm run local
# To start only the pipeline: npm run sidecar
# TEXT_LAYER_SIDECAR_URL=http://127.0.0.1:4174
# SIDECAR_RUNS_DIR=.local/pipeline/runs/docedit/v4
# SIDECAR_DOC_PREFIX=mp
# SIDECAR_REUSE_RUNS=1
# SIDECAR_DESIGN_AGENT=1
# SIDECAR_DESIGN_AGENT_MODE=aesthetic   # or "overlay"; read by the sidecar at start, so restart it after changing
# SIDECAR_PORT=4174
# TEXT_FONT_CONSOLIDATION=1  # default ON; set 0 to retain every fitted font variant
# PPTX_RUNTIME_ROOT=/absolute/path/to/codex-primary-runtime/dependencies

# Optional override for DOCX/PPTX page previews; defaults to the bundled Codex LibreOffice.
# DOCUMENT_SOFFICE_PATH=/absolute/path/to/soffice
